# Godot
.godot/
.import/
export.cfg
export_presets.cfg

# Godot Mono / C# (unused, but keep the project C#-hostile by accident)
.mono/
data_*/
mono_crash.*.json

# Build output
build/
*.tmp

# Python bytecode. The Blender lane imports its own modules in-process, and
# Blender writes a cache next to the source. Generated, and never wanted.
__pycache__/
*.pyc

# Blender's own backups of a hand-edited .blend. The lane does not commit
# .blend at all (see Docs/ARCHITECTURE.md, "the Blender lane"), but the
# pattern saves surprises when one gets authored anyway.
*.blend1

# OS
.DS_Store
Thumbs.db
desktop.ini

# Reference checkouts used for study only. Never part of the game build;
# see Docs/ARCHITECTURE.md and NOTICE.md for why nothing derived from
# another game's files may enter this repository.
external/