## The RunDirector (GDD 13.3's "RunDirector: seeded route graph, eligible room
## pools, rewards, persistence and unlock checks").
##
## This is the object the game asks "what's next". It owns a seed, holds the
## generated route graph, walks it one node at a time, opens scroll offers at the
## nodes where a build can change, and banks the run's rewards when it ends.
##
## The division of labour is deliberate:
##
##   * `RunGraph` decides *what the run contains*. Pure data, pure function of
##     the seed, and it is the same object whether it is being generated, played
##     through, or generated by a test.
##   * `RoomCatalog` decides *which authored room* each node gets, and says so
##     when an act has no authored content yet.
##   * `RewardOffer` decides *which three scrolls* are presented, from opaque ids
##     the scroll lane owns.
##   * This file is the state machine. It holds no generation logic of its own,
##     because the one interesting property of this layer - that a seed
##     reproduces a run - is a property of the graph and gets weaker the more
##     places a dice roll can hide.
##
## Node-free and engine-free, like `src/sim/` (Docs/ARCHITECTURE.md, section 2).
## No scene tree, so a headless test or a balance batch can play a thousand runs
## in a second without drawing anything.
class_name RunDirector
extends RefCounted


var seed_value := 0
var graph: RunGraph

## Which act the player is in, 0-based. GDD 3.1: "defeat the act boss, collect a
## seal and descend to the next region."
var act_index := 0
var node_id: StringName = &""

var loadout: RewardOffer.Loadout = null

## Opaque scroll ids the scroll lane has made available. GDD 6.1: new scroll
## types join the pool when discovered, so this grows across the meta-game and is
## never hard-coded here.
var scroll_pool: Array[StringName] = []

## The offer waiting to be answered at the current node, empty when there is
## none. GDD 6.4 makes this a decision the player makes, so the director refuses
## to advance past a build reward until it is resolved.
var pending_offer: Array = []

## Scrolls taken this run. GDD 3.4: these vanish on death.
var taken_scrolls: Array[StringName] = []

## Run-scoped currency (GDD 10.2's Temporary Coin). Vanishes with the run.
var temporary_coin := 0

## This run's accumulated Moon Ink. GDD 10.2: banked automatically when the run
## ends, which is why it accumulates here rather than being granted per room.
var moon_ink := 0

## Moon Ink already banked to the persistent profile. Survives death, which is
## the whole of GDD 10.1's two-track progression in one variable.
var banked_ink := 0

## GDD 10.2: "Clan Seals - boss milestones ... never purchased."
var clan_seals: Array[StringName] = []

var rooms_cleared := 0
var finished := false
var won := false

## Nodes already banked. `advance` is idempotent per node, so a caller that
## advances twice by accident does not pay out twice.
var _cleared: Dictionary = {}


func _init(p_seed := 0, p_pool: Array[StringName] = [], p_loadout: RewardOffer.Loadout = null) -> void:
	seed_value = p_seed
	scroll_pool = p_pool
	loadout = p_loadout if p_loadout != null else RewardOffer.Loadout.new()


## Generate the run and stand at the first node. GDD 3.1's "Enter fortress".
func start() -> void:
	graph = RunGraph.generate(seed_value)
	act_index = 0
	node_id = graph.act(0).entry_id
	finished = false
	won = false
	_cleared = {}


func current() -> RunGraph.RouteNode:
	if graph == null:
		return null
	return graph.node(node_id)


func current_act() -> RunGraph.Act:
	if graph == null:
		return null
	return graph.act(act_index)


## GDD 3.2's "Primary learning" for the act the player is in: "Spacing, basic
## defense, terrain" in Act I, and so on. It is on the run rather than in a
## tooltip because GDD 3.4 asks the death screen to tell the player what just
## happened, and "you died in the act about flanking" is a lesson while "you
## died in Act II" is not.
func act_theme() -> String:
	if act_index < 0 or act_index >= RunTuning.ACT_THEME.size():
		return ""
	return RunTuning.ACT_THEME[act_index]


## At a fork this is a real choice the player reads before committing (GDD 8.2:
## "branch choices must preview risk and reward"). Everywhere else it is a
## single-option list, so the map screen and the input layer have one shape to
## handle instead of two.
func options() -> Array:
	var n := current()
	var out: Array = []
	if n == null:
		return out
	if n.next.is_empty():
		return out
	if n.choices.size() == n.next.size():
		for c in n.choices:
			out.append(c)
		return out
	var only := RewardOffer.Choice.new()
	only.index = 0
	only.next_id = n.next[0]
	only.label = RunGraph.kind_name(n.kind)
	only.risk = n.risk
	only.reward_preview = RunGraph.reward_preview_for(n.kind)
	out.append(only)
	return out


func is_fork() -> bool:
	var n := current()
	return n != null and n.choices.size() > 1


## True when a scroll choice is owed before the next door opens. GDD 3.1's build
## step; GDD 6.4's three options.
func awaiting_scroll_choice() -> bool:
	return not pending_offer.is_empty()


## The three options, built on demand from the node's own RNG stream. Same seed
## and same loadout gives the same three ids in the same order, which is what
## GDD 8.4's "reward offers" means and what GDD 13.4 asks to be automated.
func offer_scroll() -> Array:
	if not pending_offer.is_empty():
		return pending_offer
	var n := current()
	if n == null or not RunGraph.kind_grants_build_reward(n.kind):
		return [] as Array
	# GDD 6.4 promises exactly three. A pool that cannot deliver three usable
	# scrolls is a content fault, and surfacing it as an empty prompt would hide
	# it until a player stood in a forge staring at nothing.
	if scroll_pool.size() < RunTuning.MIN_SCROLL_POOL:
		return [] as Array
	var salt := RunGraph.hash_text(String(n.id) + loadout.fingerprint())
	var rng := RunGraph.stream(seed_value, RunTuning.STREAM_REWARD, salt)
	pending_offer = RewardOffer.build(rng, scroll_pool, loadout)
	return pending_offer


## Take one of the offered scrolls. Returns false when the id was not on offer,
## which is worth a return value: it is the difference between a player picking
## and a caller inventing.
func accept_scroll(scroll_id: StringName) -> bool:
	var found := false
	for c in pending_offer:
		if (c as RewardOffer.Choice).scroll_id == scroll_id:
			found = true
			break
	if not found:
		return false
	taken_scrolls.append(scroll_id)
	loadout.owned.append(scroll_id)
	pending_offer = [] as Array
	return true


## Decline the offer. GDD 6.4 puts a reroll behind a resource "later, but not in
## the first prototype", so declining is free and takes nothing.
func skip_scroll() -> void:
	pending_offer = [] as Array


## Clear the current node and move on. `option` is ignored unless this node is a
## fork. Returns false when the run is over.
##
## Refuses while a scroll offer is unresolved: a forge the player can walk
## straight out of is not a reward node.
func advance(option := 0) -> bool:
	if finished or graph == null:
		return false
	var n := current()
	if n == null:
		finished = true
		return false
	if awaiting_scroll_choice():
		return false

	_bank_node(n)

	if n.next.is_empty():
		return _finish_act(n)

	var index := clampi(option, 0, n.next.size() - 1)
	node_id = n.next[index]
	return true


## The act boss has been cleared: bank the seal and descend, or end the run.
func _finish_act(boss: RunGraph.RouteNode) -> bool:
	var next_act := act_index + 1
	if next_act >= graph.acts.size():
		finished = true
		won = true
		return false
	act_index = next_act
	node_id = graph.act(next_act).entry_id
	return true


func _bank_node(n: RunGraph.RouteNode) -> void:
	if _cleared.has(n.id):
		return
	_cleared[n.id] = true
	match n.kind:
		RunGraph.Kind.BOSS:
			# GDD 3.1: "defeat the act boss, collect a seal and descend".
			moon_ink += RunTuning.INK_BOSS
			var seal := StringName("seal_act_%d" % n.act)
			if not clan_seals.has(seal):
				clan_seals.append(seal)
		RunGraph.Kind.ELITE:
			# GDD 10.2: Moon Ink is "awarded for elites, new room feats and
			# bosses".
			moon_ink += RunTuning.INK_ELITE
			temporary_coin += RunTuning.COIN_ELITE
		RunGraph.Kind.STANDARD_COMBAT:
			temporary_coin += RunTuning.COIN_STANDARD
		RunGraph.Kind.NARRATIVE:
			temporary_coin += RunTuning.COIN_STORY
		RunGraph.Kind.ENTRANCE, RunGraph.Kind.TUTORIAL, RunGraph.Kind.CHOICE:
			# Structural. A doorway is not a room and does not pay out.
			return
	if not n.room_id.is_empty():
		rooms_cleared += 1


## GDD 3.4 and GDD 10.2: the run ends, Moon Ink is banked to the persistent
## profile, and everything run-scoped is wiped - build, currency, consumables.
## Clan seals survive because they are milestones and "never purchased".
##
## The returned dictionary is the death readout GDD 3.4 asks for ("Death
## immediately reveals cause, collected rewards and progress") and the shape
## GDD 18 wants attached to a telemetry record.
func finish_run(victory: bool) -> Dictionary:
	won = victory
	finished = true
	banked_ink += moon_ink
	var result := {
		"seed": seed_value,
		"victory": victory,
		"moon_ink": moon_ink,
		"clan_seals": clan_seals.duplicate(),
		"scrolls": taken_scrolls.duplicate(),
		"rooms_cleared": rooms_cleared,
		"acts": act_index + (1 if victory else 0),
		"route": fingerprint(),
		"loadout": loadout.fingerprint(),
	}
	moon_ink = 0
	temporary_coin = 0
	var none: Array[StringName] = []
	taken_scrolls = none.duplicate()
	loadout.reset_for_run()
	return result


## The run's identity for telemetry. GDD 18: "Link each result to a run seed and
## ability loadout"; GDD 8.4: "Record seed plus build and room-clear logs for bug
## reproduction." This is the third piece - the route the seed produced.
func fingerprint() -> String:
	if graph == null:
		return "seed=%d (not generated)" % seed_value
	return graph.fingerprint()
